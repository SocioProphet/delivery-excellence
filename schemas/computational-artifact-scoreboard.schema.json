{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socioprophet.io/schemas/delivery-excellence/computational-artifact-scoreboard.schema.json",
  "title": "ComputationalArtifactScoreboard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scoreboardId", "generatedAt", "artifactRef", "ownerRepo", "runRef", "metrics", "evidenceRefs"],
  "properties": {
    "schemaVersion": { "const": "v0.1" },
    "scoreboardId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "minLength": 1 },
    "artifactRef": { "type": "string", "minLength": 1 },
    "ownerRepo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "runRef": { "type": "string", "minLength": 1 },
    "runtimeProfile": { "type": "string" },
    "safetyClass": { "enum": ["advisory", "bounded", "privileged", "prohibited"] },
    "metricSet": { "type": "string", "default": "computational-artifact-v0" },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "unit", "direction", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": { "type": ["number", "string"] },
          "unit": { "type": "string", "minLength": 1 },
          "direction": { "enum": ["minimize", "maximize", "informational"] },
          "threshold": { "type": ["number", "string"] },
          "status": { "enum": ["pass", "warn", "fail", "unknown"] },
          "evidenceRef": { "type": "string" }
        }
      }
    },
    "rollup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reproducibilityScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "validationStatus": { "enum": ["pass", "warn", "fail", "unknown"] },
        "promotionStatus": { "enum": ["blocked", "candidate", "promoted", "deprecated", "unknown"] }
      }
    },
    "evidenceRefs": { "type": "array", "items": { "type": "string" } },
    "lineageRefs": { "type": "array", "items": { "type": "string" } }
  }
}
